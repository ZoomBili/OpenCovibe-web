[
  {
    "stepTitle": "OpenCovibe Web 设置",
    "items": [
      {
        "type": "text",
        "field": "port",
        "label": "访问端口",
        "initValue": "9476",
        "rules": [
          {
            "required": true,
            "message": "请输入访问端口"
          },
          {
            "pattern": "^(102[4-9]|10[3-9][0-9]|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
            "message": "端口必须在 1024 到 65535 之间"
          }
        ]
      },
      {
        "type": "password",
        "field": "wizard_token",
        "label": "浏览器访问令牌",
        "placeholder": "留空则保留当前令牌"
      },
      {
        "type": "text",
        "field": "wizard_workspace",
        "label": "默认工作区",
        "initValue": "/vol1/1000/aicoding",
        "rules": [
          {
            "required": true,
            "message": "请输入默认工作区"
          },
          {
            "pattern": "^/[^\\r\\n]*$",
            "message": "工作区必须是 Linux 绝对路径"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_home",
        "label": "CLI 登录用户 HOME",
        "initValue": "/root",
        "rules": [
          {
            "required": true,
            "message": "请输入 HOME 路径"
          },
          {
            "pattern": "^/[^\\r\\n]*$",
            "message": "HOME 必须是 Linux 绝对路径"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_claude_path",
        "label": "Claude Code 路径",
        "placeholder": "留空自动查找"
      },
      {
        "type": "text",
        "field": "wizard_codex_path",
        "label": "Codex 路径",
        "placeholder": "留空自动查找"
      },
      {
        "type": "text",
        "field": "wizard_node_path",
        "label": "Node.js 路径",
        "placeholder": "留空自动查找，例如 /path/to/node"
      }
    ]
  }
]
