OPENCOVIBE_BIND=0.0.0.0
OPENCOVIBE_PORT=9476
OPENCOVIBE_TOKEN=replace-with-a-long-random-token
OPENCOVIBE_ALLOWED_ORIGINS=https://code.example.com
OPENCOVIBE_CLAUDE_PATH=/home/your-user/.local/bin/claude
OPENCOVIBE_CODEX_PATH=/home/your-user/.local/bin/codex
PATH=/home/your-user/.local/bin:/usr/local/bin:/usr/bin:/bin
RUST_LOG=opencovibe_server=info,warn
